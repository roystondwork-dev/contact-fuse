{
  "name": "@contact-fuse/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local Fastify server: OAuth, merge jobs and serving the web UI.",
  "scripts": {
    "dev": "CONTACT_FUSE_DEV_UI_ORIGIN=http://127.0.0.1:5173 tsx watch src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@contact-fuse/core": "workspace:*",
    "@contact-fuse/provider-google": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@napi-rs/keyring": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "env-paths": "^4.0.0",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "msw": "^3.0.3",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15"
  }
}
